import { describe, it, expect, vi, beforeEach, type Mock } from 'vitest';
import { {{nameLower}}Service } from '../{{nameLower}}.service';
import { api } from '@/lib/axios';

vi.mock('@/lib/axios', () => ({
  api: {
    get: vi.fn(),
    post: vi.fn(),
    put: vi.fn(),
    delete: vi.fn(),
    patch: vi.fn(),
  },
}));

describe('{{nameLower}}Service', () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it('get{{nameCapitalized}}s calls correct endpoint with all options', async () => {
    (api.get as Mock).mockResolvedValue({ data: [] });
    await {{nameLower}}Service.get{{nameCapitalized}}s({
      all: true,
      searchWord: 'test',
      searchFields: ['name'],
      sort: { orderBy: 'name', orderDirection: 'desc' },
      filters: { active: 'true' }
    });
    expect(api.get).toHaveBeenCalledWith('/v1/{{nameLower}}/all', {
      params: expect.objectContaining({
        searchWord: 'test',
        searchFields: 'name',
        orderBy: 'name',
        orderDirection: 'desc',
        active: 'true'
      })
    });
  });

  it('get{{nameCapitalized}}s calls correct endpoint with minimal options', async () => {
    (api.get as Mock).mockResolvedValue({ data: [] });
    await {{nameLower}}Service.get{{nameCapitalized}}s({});
    expect(api.get).toHaveBeenCalledWith('/v1/{{nameLower}}', {
      params: {
        page: 0,
        size: 25
      }
    });
  });

  it('get{{nameCapitalized}} calls correct endpoint', async () => {
    (api.get as Mock).mockResolvedValue({ data: {} });
    await {{nameLower}}Service.get{{nameCapitalized}}('1');
    expect(api.get).toHaveBeenCalledWith('/v1/{{nameLower}}/1');
  });

  it('create{{nameCapitalized}} calls correct endpoint', async () => {
    (api.post as Mock).mockResolvedValue({ data: {} });
    await {{nameLower}}Service.create{{nameCapitalized}}({ name: 'Item 1' });
    expect(api.post).toHaveBeenCalledWith('/v1/{{nameLower}}', { name: 'Item 1' });
  });

  it('update{{nameCapitalized}} calls correct endpoint', async () => {
    (api.put as Mock).mockResolvedValue({ data: {} });
    await {{nameLower}}Service.update{{nameCapitalized}}('1', { name: 'Item 1' });
    expect(api.put).toHaveBeenCalledWith('/v1/{{nameLower}}/1', { name: 'Item 1' });
  });

  it('delete{{nameCapitalized}} calls correct endpoint', async () => {
    (api.delete as Mock).mockResolvedValue({ data: {} });
    await {{nameLower}}Service.delete{{nameCapitalized}}('1');
    expect(api.delete).toHaveBeenCalledWith('/v1/{{nameLower}}/1');
  });

  it('toggleStatus calls correct endpoint', async () => {
    (api.patch as Mock).mockResolvedValue({ data: {} });
    await {{nameLower}}Service.toggleStatus('1', true);
    expect(api.patch).toHaveBeenCalledWith('/v1/{{nameLower}}/1/status', { active: true });
  });
});