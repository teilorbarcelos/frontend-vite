import { DataTable } from '@/components/ui/DataTable';
import { useAuth } from '@/hooks/useAuth';
import { useDataTable } from '@/hooks/useDataTable';
import { useQuery } from '@tanstack/react-query';
import { useMemo, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { ListPageHeader } from '@/components/ui/ListPageHeader';
import { {{nameCapitalized}}Filters } from '../components/{{nameCapitalized}}Filters';
import { {{upper nameLower}}_SEARCHABLE_FIELDS as searchFields } from '../constants/{{nameLower}}.constants';
import { get{{nameCapitalized}}Columns } from '../constants/{{nameLower}}HeaderMap';
import { {{nameLower}}Service } from '../services/{{nameLower}}.service';
import { {{nameLower}}Mutations } from '../hooks/{{nameLower}}.mutations';

export function {{nameCapitalized}}ListPage() {
  const {
    page,
    size,
    searchWord,
    filters,
    sort,
    handleSearch,
    handleFilter,
    tableProps: dataTableProps
  } = useDataTable({ 
    defaultSort: { orderDirection: undefined } 
  });

  const [isFilterOpen, setIsFilterOpen] = useState(false);
  const navigate = useNavigate();
  const { hasPermission } = useAuth();

  const permissions = useMemo(() => ({
    canCreate: hasPermission('{{nameLower}}', 'create'),
    canUpdate: hasPermission('{{nameLower}}', 'create'),
    canDelete: hasPermission('{{nameLower}}', 'delete'),
  }), [hasPermission]);

  const { data, isError, isFetching } = useQuery({
    queryKey: ['{{nameLower}}s', page, size, searchWord, filters, sort],
    queryFn: () => {{nameLower}}Service.get{{nameCapitalized}}s({
      page, 
      size, 
      searchWord, 
      searchFields, 
      filters,
      sort,
      all: true
    }),
    placeholderData: (prev) => prev,
  });

  const toggleStatusMutation = {{nameLower}}Mutations.useToggleStatus();
  const deleteMutation = {{nameLower}}Mutations.useDelete();

  const columns = get{{nameCapitalized}}Columns(
    (id, active) => toggleStatusMutation.mutate({ id, active }),
    (id) => navigate(`/{{nameLower}}s/update/${id}`),
    (id) => deleteMutation.mutate(id),
    permissions
  );

  if (isError) return <div className="p-8 text-center text-red-500">Erro ao carregar registros</div>;

  return (
    <div className="flex-1 flex flex-col min-h-0">
      <ListPageHeader
        title="{{nameCapitalized}}s"
        onSearch={handleSearch}
        onFilterClick={() => setIsFilterOpen(true)}
        filterCount={Object.keys(filters).length}
        onCreateClick={permissions.canCreate ? () => navigate('/{{nameLower}}s/new') : undefined}
        createLabel="Novo Registro"
      />

      <{{nameCapitalized}}Filters
        isOpen={isFilterOpen}
        onClose={() => setIsFilterOpen(false)}
        onFilter={handleFilter}
        initialValues={filters}
      />

      <DataTable
        {...dataTableProps}
        data={data?.items || []}
        headerMap={columns}
        isLoading={isFetching}
        totalItems={data?.total || 0}
      />
    </div>
  );
}
