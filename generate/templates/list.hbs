import { useState } from 'react';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { useNavigate } from 'react-router-dom';
import { Plus, Edit2, Trash2 } from 'lucide-react';
import { {{nameLower}}Service } from '../services/{{nameLower}}.service';
import { Button } from '@/components/ui/Button';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/Table';
import { Pagination } from '@/components/ui/Pagination';

export function {{nameCapitalized}}ListPage() {
  const [page, setPage] = useState(0);
  const [size, setSize] = useState(15);
  const navigate = useNavigate();
  const queryClient = useQueryClient();

  const { data, isLoading, isError } = useQuery({
    queryKey: ['{{nameLower}}s', page, size],
    queryFn: () => {{nameLower}}Service.get{{nameCapitalized}}s(page, size),
  });

  const toggleStatusMutation = useMutation({
    mutationFn: ({ id, active }: { id: string; active: boolean }) => {{nameLower}}Service.toggleStatus(id, active),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['{{nameLower}}s'] });
    },
  });

  const deleteMutation = useMutation({
    mutationFn: (id: string) => {{nameLower}}Service.delete{{nameCapitalized}}(id),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['{{nameLower}}s'] });
    },
  });

  if (isLoading) return <div className="p-8 text-center text-gray-500">Loading {{nameLower}}s...</div>;
  if (isError) return <div className="p-8 text-center text-red-500">Error loading {{nameLower}}s</div>;

  return (
    <div className="space-y-6">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold text-gray-900">{{nameCapitalized}}s</h1>
        <Button onClick={() => navigate('/{{nameLower}}s/new')}>
          <Plus className="w-4 h-4 mr-2" />
          New {{nameCapitalized}}
        </Button>
      </div>

      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>Name</TableHead>
            <TableHead>Status</TableHead>
            <TableHead className="text-right">Actions</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {data?.items?.map((item: any) => (
            <TableRow key={item.id}>
              <TableCell className="font-medium text-gray-900">{item.name}</TableCell>
              <TableCell>
                <button
                  onClick={() => toggleStatusMutation.mutate({ id: item.id, active: !item.active })}
                  className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full cursor-pointer ${
                    item.active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                  }`}
                >
                  {item.active ? 'Active' : 'Inactive'}
                </button>
              </TableCell>
              <TableCell className="text-right space-x-2">
                <Button variant="ghost" size="sm" onClick={() => navigate(`/{{nameLower}}s/${item.id}`)}>
                  <Edit2 className="w-4 h-4 text-blue-600" />
                </Button>
                <Button variant="ghost" size="sm" onClick={() => {
                  if (confirm('Are you sure you want to delete this {{nameLower}}?')) {
                    deleteMutation.mutate(item.id);
                  }
                }}>
                  <Trash2 className="w-4 h-4 text-red-600" />
                </Button>
              </TableCell>
            </TableRow>
          ))}
          {!data?.items?.length && (
            <TableRow>
              <TableCell colSpan={3} className="h-24 text-center text-gray-500">
                No {{nameLower}}s found.
              </TableCell>
            </TableRow>
          )}
        </TableBody>
      </Table>

      {data?.total > 0 && (
        <Pagination
          page={page}
          total={data.total}
          size={size}
          onPageChange={setPage}
          onSizeChange={setSize}
        />
      )}
    </div>
  );
}
