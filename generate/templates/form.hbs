import { useNavigate, useParams } from 'react-router-dom';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';
import { useQuery } from '@tanstack/react-query';
import { {{nameLower}}Service } from '../services/{{nameLower}}.service';
import { {{nameLower}}Mutations } from '../hooks/{{nameLower}}.mutations';
import { Button } from '@/components/ui/Button';
import { Input } from '@/components/ui/Input';

const {{nameLower}}Schema = z.object({
  name: z.string().min(1, 'Nome é obrigatório'),
});

type {{nameCapitalized}}Form = z.infer<typeof {{nameLower}}Schema>;

export function {{nameCapitalized}}FormPage() {
  const { id } = useParams();
  const navigate = useNavigate();
  const isEditing = Boolean(id && id !== 'new');

  const { data: item, isLoading: isLoadingItem } = useQuery({
    queryKey: ['{{nameLower}}', id],
    queryFn: () => {{nameLower}}Service.get{{nameCapitalized}}(id as string),
    enabled: isEditing,
  });

  const {
    register,
    handleSubmit,
    formState: { errors },
  } = useForm<{{nameCapitalized}}Form>({
    resolver: zodResolver({{nameLower}}Schema),
    values: item ? {
      name: item.name,
    } : undefined,
  });

  const mutation = {{nameLower}}Mutations.useSave<{{nameCapitalized}}Form>(isEditing, id, {
    onSuccess: () => navigate('/{{nameLower}}s')
  });

  const onSubmit = (data: {{nameCapitalized}}Form) => {
    mutation.mutate(data);
  };

  if (isEditing && isLoadingItem) {
    return <div className="p-8 text-center text-gray-500">Carregando dados...</div>;
  }

  return (
    <div className="overflow-y-auto flex-1 pb-8">
      <div className="max-w-2xl mx-auto space-y-6 bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <div className="flex items-center justify-between border-b border-gray-200 pb-4">
          <h1 className="text-xl font-bold text-gray-900">
            {isEditing ? 'Editar Registro' : 'Novo Registro'}
          </h1>
          <Button variant="ghost" onClick={() => navigate('/{{nameLower}}s')}>
            Cancelar
          </Button>
        </div>

        <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
          <Input
            label="Nome"
            {...register('name')}
            error={errors.name?.message}
            placeholder="Nome do registro"
          />
          
          <div className="pt-4 flex justify-end space-x-3">
            <Button type="button" variant="secondary" onClick={() => navigate('/{{nameLower}}s')}>
              Cancelar
            </Button>
            <Button type="submit" disabled={mutation.isPending}>
              {mutation.isPending ? 'Salvando...' : 'Salvar'}
            </Button>
          </div>
        </form>
      </div>
    </div>
  );
}