import { useEffect } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { {{nameLower}}Service } from '../services/{{nameLower}}.service';
import { Button } from '@/components/ui/Button';
import { Input } from '@/components/ui/Input';

const {{nameLower}}Schema = z.object({
  name: z.string().min(1, 'Name is required'),
});

type {{nameCapitalized}}Form = z.infer<typeof {{nameLower}}Schema>;

export function {{nameCapitalized}}FormPage() {
  const { id } = useParams();
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const isEditing = Boolean(id && id !== 'new');

  const { data: item, isLoading } = useQuery({
    queryKey: ['{{nameLower}}', id],
    queryFn: () => {{nameLower}}Service.get{{nameCapitalized}}(id as string),
    enabled: isEditing,
  });

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors },
  } = useForm<{{nameCapitalized}}Form>({
    resolver: zodResolver({{nameLower}}Schema),
    defaultValues: {
      name: '',
    },
  });

  useEffect(() => {
    if (item) {
      reset({
        name: item.name,
      });
    }
  }, [item, reset]);

  const mutation = useMutation({
    mutationFn: (data: {{nameCapitalized}}Form) => {
      if (isEditing) {
        return {{nameLower}}Service.update{{nameCapitalized}}(id as string, data);
      }
      return {{nameLower}}Service.create{{nameCapitalized}}(data);
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['{{nameLower}}s'] });
      navigate('/{{nameLower}}s');
    },
  });

  const onSubmit = (data: {{nameCapitalized}}Form) => {
    mutation.mutate(data);
  };

  if (isEditing && isLoading) {
    return <div className="p-8 text-center text-gray-500">Loading data...</div>;
  }

  return (
    <div className="max-w-2xl mx-auto space-y-6 bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <div className="flex items-center justify-between border-b border-gray-200 pb-4">
        <h1 className="text-xl font-bold text-gray-900">
          {isEditing ? 'Edit {{nameCapitalized}}' : 'New {{nameCapitalized}}'}
        </h1>
        <Button variant="ghost" onClick={() => navigate('/{{nameLower}}s')}>
          Cancel
        </Button>
      </div>

      <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
        <Input
          label="Name"
          {...register('name')}
          error={errors.name?.message}
          placeholder="{{nameCapitalized}} Name"
        />

        <div className="pt-4 flex justify-end space-x-3">
          <Button type="button" variant="secondary" onClick={() => navigate('/{{nameLower}}s')}>
            Cancel
          </Button>
          <Button type="submit" disabled={mutation.isPending}>
            {mutation.isPending ? 'Saving...' : 'Save'}
          </Button>
        </div>
      </form>
    </div>
  );
}
