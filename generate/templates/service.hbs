import { api } from '@/lib/axios';

export interface {{nameCapitalized}} {
  id: string;
  name: string;
  active: boolean;
  created_at: string;
}

export const {{nameLower}}Service = {
  get{{nameCapitalized}}s: async (options: {
    page?: number;
    size?: number;
    searchWord?: string;
    searchFields?: string[];
    filters?: Record<string, unknown>;
    sort?: { orderBy?: string; orderDirection?: string };
    all?: boolean;
  }) => {
    const { page = 0, size = 25, searchWord, searchFields, filters = {}, sort, all } = options;
    const res = await api.get(`/v1/{{nameLower}}${all ? '/all' : ''}`, { 
      params: { 
        page, 
        size,
        ...(searchWord ? { searchWord, searchFields: searchFields?.join(',') } : {}),
        ...filters,
        ...(sort?.orderBy ? { orderBy: sort.orderBy, orderDirection: sort.orderDirection } : {})
      } 
    });
    return res.data;
  },
  get{{nameCapitalized}}: async (id: string) => {
    const res = await api.get(`/v1/{{nameLower}}/${id}`);
    return res.data;
  },
  create{{nameCapitalized}}: async (data: Omit<{{nameCapitalized}}, 'id' | 'active' | 'created_at'>) => {
    const res = await api.post('/v1/{{nameLower}}', data);
    return res.data;
  },
  update{{nameCapitalized}}: async (id: string, data: Partial<{{nameCapitalized}}>) => {
    const res = await api.put(`/v1/{{nameLower}}/${id}`, data);
    return res.data;
  },
  delete{{nameCapitalized}}: async (id: string) => {
    const res = await api.delete(`/v1/{{nameLower}}/${id}`);
    return res.data;
  },
  toggleStatus: async (id: string, active: boolean) => {
    const res = await api.patch(`/v1/{{nameLower}}/${id}/status`, { active });
    return res.data;
  }
};